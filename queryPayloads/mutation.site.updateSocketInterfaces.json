{
    "operationName": "siteUpdateSocketInterfaces",
    "query": "mutation siteUpdateSocketInterfaces ( $accountId:ID! $updateSocketInterfacesInput:UpdateSocketInterfacesInput!) {\n\tsite ( accountId:$accountId ) {\n\t\tupdateSocketInterfaces ( input:$updateSocketInterfacesInput  )  {\n\t\t\tsiteId\n\t\t\tsocketInterfaceId\n\t\t}\n\t}\t\n}",
    "variables": {
        "updateSocketInterfacesInput": {
            "site": {
                "by": "ID",
                "input": "string"
            },
            "socketInterface": {
                "altWan": {
                    "privateGatewayIp": "example_value",
                    "privateInterfaceIp": "example_value",
                    "privateNetwork": "example_value",
                    "privateVlanTag": 1,
                    "publicGatewayIp": "example_value",
                    "publicInterfaceIp": "example_value",
                    "publicNetwork": "example_value",
                    "publicVlanTag": 1
                },
                "bandwidth": {
                    "downstreamBandwidth": 1,
                    "downstreamBandwidthMbpsPrecision": 1.5,
                    "upstreamBandwidth": 1,
                    "upstreamBandwidthMbpsPrecision": 1.5
                },
                "destType": "CATO",
                "lag": {
                    "minLinks": 1
                },
                "lan": {
                    "localIp": "example_value",
                    "subnet": "example_value",
                    "translatedSubnet": "example_value"
                },
                "name": "string",
                "offCloud": {
                    "enabled": true,
                    "publicIp": "example_value",
                    "publicStaticPort": 1
                },
                "socketInterfaceId": "LAN1",
                "vrrp": {
                    "vrrpType": "VIA_SWITCH"
                },
                "wan": {
                    "precedence": "ACTIVE",
                    "role": "wan_1"
                }
            }
        }
    }
}