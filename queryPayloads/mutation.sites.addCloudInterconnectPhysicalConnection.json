            "popLocation": {
                "by": "ID",
                "input": "string"
            },
            "privateCatoIp": "192.0.2.1",
            "privateSiteIp": "192.0.2.1",
            "serviceProviderName": "string",
            "site": {
                "by": "ID",
                "input": "string"
            },
            "subnet": "192.0.2.0/24",
            "upstreamBwLimit": 100,
            "vlan": 100
        }
    }
