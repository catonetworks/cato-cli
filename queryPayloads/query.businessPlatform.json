{
    "operationName": "businessPlatform",
    "query": "query businessPlatform ( $accountId:ID! $businessPlatformAccountListInput:BusinessPlatformAccountListInput) {\n\tbusinessPlatform ( accountId:$accountId ) {\n\t\taccountList ( input:$businessPlatformAccountListInput  )  {\n\t\t\titems {\n\t\t\t\tid\n\t\t\t\texternalName\n\t\t\t\taccount {\n\t\t\t\t\tid\n\t\t\t\t\tname\n\t\t\t\t}\n\t\t\t\tpartner {\n\t\t\t\t\tid\n\t\t\t\t\tname\n\t\t\t\t}\n\t\t\t\taccountExternalName\n\t\t\t\tdescription\n\t\t\t\tplan\n\t\t\t\texpiresOn\n\t\t\t\testimatedCloseDate\n\t\t\t\tcontactFirstName\n\t\t\t\tcontactLastName\n\t\t\t\tcontactEmail\n\t\t\t\tcompanyWebsite\n\t\t\t\tcountry\n\t\t\t\tcity\n\t\t\t\tstate\n\t\t\t\tstreet\n\t\t\t\tpostalCode\n\t\t\t\tcmaCreatedBy\n\t\t\t\tcmaCreatedAt\n\t\t\t}\n\t\t\tpaging {\n\t\t\t\ttotal\n\t\t\t}\n\t\t}\n\t\tcountAccountByPlan {\n\t\t\titems {\n\t\t\t\tplan\n\t\t\t\tcount\n\t\t\t}\n\t\t}\n\t\tsettings {\n\t\t\tapprovalEnabled\n\t\t}\n\t}\t\n}",
    "variables": {
        "businessPlatformAccountListInput": {
            "filter": {
                "account": {
                    "accountInclusion": "ALL_ACCOUNTS",
                    "in": [
                        "id1",
                        "id2"
                    ]
                },
                "expiresOn": {
                    "between": [
                        "example1",
                        "example2"
                    ],
                    "eq": "example_value",
                    "gt": "example_value",
                    "gte": "example_value",
                    "in": [
                        "example1",
                        "example2"
                    ],
                    "lt": "example_value",
                    "lte": "example_value",
                    "neq": "example_value",
                    "nin": [
                        "example1",
                        "example2"
                    ]
                },
                "freeText": {
                    "search": "string"
                },
                "plan": {
                    "eq": "PENDING_APPROVAL",
                    "in": "PENDING_APPROVAL"
                }
            },
            "paging": {
                "from": 1,
                "limit": 1
            },
            "sort": {
                "account": {
                    "direction": "ASC",
                    "priority": 1
                },
                "cmaCreatedAt": {
                    "direction": "ASC",
                    "priority": 1
                },
                "cmaCreatedBy": {
                    "direction": "ASC",
                    "priority": 1
                },
                "partner": {
                    "direction": "ASC",
                    "priority": 1
                },
                "plan": {
                    "direction": "ASC",
                    "priority": 1
                }
            }
        }
    }
}