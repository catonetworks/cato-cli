{
    "operationName": "businessPlatformPartnerList",
    "query": "query businessPlatformPartnerList ( $accountId:ID! $businessPlatformPartnerListInput:BusinessPlatformPartnerListInput) {\n\tbusinessPlatform ( accountId:$accountId ) {\n\t\tpartnerList ( input:$businessPlatformPartnerListInput  )  {\n\t\t\titems {\n\t\t\t\tid\n\t\t\t\taccount {\n\t\t\t\t\tid\n\t\t\t\t\tname\n\t\t\t\t}\n\t\t\t\tname\n\t\t\t\tdescription\n\t\t\t\tcreatedBy\n\t\t\t\tcreatedAt\n\t\t\t}\n\t\t\tpaging {\n\t\t\t\ttotal\n\t\t\t}\n\t\t}\n\t}\t\n}",
    "variables": {
        "businessPlatformPartnerListInput": {
            "filter": {
                "account": {
                    "accountInclusion": "ALL_ACCOUNTS",
                    "in": [
                        "id1",
                        "id2"
                    ]
                },
                "freeText": {
                    "search": "string"
                }
            },
            "paging": {
                "from": 1,
                "limit": 1
            },
            "sort": {
                "account": {
                    "direction": "ASC",
                    "priority": 1
                },
                "createdAt": {
                    "direction": "ASC",
                    "priority": 1
                },
                "createdBy": {
                    "direction": "ASC",
                    "priority": 1
                },
                "name": {
                    "direction": "ASC",
                    "priority": 1
                }
            }
        }
    }
}