                        "in": [
                            "string1",
                            "string2"
                        ],
                        "neq": "string",
                        "nin": [
                            "string1",
                            "string2"
                        ]
                    }
                ],
                "reportCreateDate": [
                    {
                        "between": [
                            "2026-01-02T15:04:05Z"
                        ],
                        "eq": "2026-01-02T15:04:05Z",
                        "gt": "2026-01-02T15:04:05Z",
                        "gte": "2026-01-02T15:04:05Z",
                        "in": [
                            "2026-01-02T15:04:05Z"
                        ],
                        "lt": "2026-01-02T15:04:05Z",
                        "lte": "2026-01-02T15:04:05Z",
                        "neq": "2026-01-02T15:04:05Z",
                        "nin": [
                            "2026-01-02T15:04:05Z"
                        ]
                    }
                ]
            },
            "paging": {
