{
    "operationName": "sandbox",
    "query": "query sandbox ( $accountId:ID! $sandboxReportsInput:SandboxReportsInput!) {\n\tsandbox ( accountId:$accountId ) {\n\t\treports ( input:$sandboxReportsInput  )  {\n\t\t\treport {\n\t\t\t\tfileName\n\t\t\t\tfileHash\n\t\t\t\tcreationDate\n\t\t\t\texpirationDate\n\t\t\t\tverdict\n\t\t\t\tstatus\n\t\t\t\tdownloadUrl\n\t\t\t\tfailureReason\n\t\t\t}\n\t\t\tpageInfo {\n\t\t\t\ttotal\n\t\t\t}\n\t\t}\n\t}\t\n}",
    "variables": {
        "sandboxReportsInput": {
            "filter": {
