{
    "ignoreOperations": {
        // The following require additional configuration
        "query.site.secondaryAwsVSocket": {},
        "query.site.secondaryAzureVSocket": {},
        // Device response selection and group-list members are rejected by the CI server
        "query.devices": {},
        "query.groups.groupList": {},
        // Existing LAN policy violates non-null SocketLanFirewallRulePayload.access
        "query.policy.socketLan.policy": {},
        // Catalog API rollout is unavailable even with valid paging input
        "query.catalogs.catalogApplicationList": {},
        // Invocation IDs exist, but sessionConversation returns an internal server error
        "query.aiSecurity": {},
        // Pop-location resolver reports missing account tag; no BGP profile fixture exists
        "query.popLocations": {},
        // No Cloud Interconnect site or physical connection exists
        "query.site.cloudInterconnectConnectionConnectivity": {},
        "query.site.cloudInterconnectPhysicalConnection": {},
        "query.site.cloudInterconnectPhysicalConnectionId": {},
        // No private PoP/Cloud Interconnect fixture exists
        "query.site.retrieveUsedVlanIDs": {},
        // No secondary GCP vSocket exists
        "query.site.secondaryGcpVSocket": {},
        // No Wi-Fi radio profile fixture exists for the CI account
        "query.site.wifiRadioProfile": {},
        "query.site.wifiRadioProfileBySite": {},
        // Business Platform is not rolled out; notification has server-schema/audit errors
        "query.businessPlatform": {},
        "query.notification": {},
        // CI account lacks privileges for the anti-malware file-hash policy
        "query.policy.antiMalwareFileHash.policy": {},
        // CI endpoint lacks PostureHistoricalSummary.comparisons from the upstream schema
        "query.posture.dailySummaryList": {},
        // DNS APIs are not rolled out to this account
        "query.networkConfig.dns.serverSet": {},
        "query.networkConfig.dns.serverSetList": {},
        "query.networkConfig.dns.suffixSet": {},
        "query.networkConfig.dns.suffixSetList": {}
    },
    "defaultValues": {
        "timeFrame": "last.P1D",
        "adminID": "76653",
        "platforms": [
            "OSX"
        ]
    },
    "overrideOperationPayload": {
        "query.catalogs.catalogApplicationList": {
            "payload": {
                "catalogApplicationListInput": {
                    "paging": {"from": 0, "limit": 1}
                }
            },
            "assertions": ["catalogs.catalogApplicationList"]
        },
        "query.appStats": {
            "payload": {
                "appStatsFilter": [
                    {
                        "fieldName": "risk_score",
                        "operator": "gte",
                        "values": [
                            "5"
                        ]
                    }
                ],
                "appStatsSort": [
                    {
                        "fieldName": "risk_score",
                        "order": "desc"
                    }
                ],
                "dimension": [
                    {
                        "fieldName": "application_name"
                    },
                    {
                        "fieldName": "risk_score"
                    },
                    {
                        "fieldName": "user_name"
                    }
                ],
                "measure": [
                    {
                        "aggType": "sum",
                        "fieldName": "traffic"
                    },
                    {
                        "aggType": "sum",
                        "fieldName": "flows_created"
                    }
                ],
                "timeFrame": "last.P1D"
            },
            "assertions": [
                "appStats",
                "appStats.records"
            ]
        },
        "query.appStatsTimeSeries": {
            "payload": {
                "buckets": 24,
                "dimension": [
                    {
                        "fieldName": "user_name"
                    },
                    {
                        "fieldName": "application_name"
                    }
                ],
                "perSecond": false,
                "measure": [
                    {
                        "aggType": "sum",
                        "fieldName": "upstream"
                    },
                    {
                        "aggType": "sum",
                        "fieldName": "downstream"
                    },
                    {
                        "aggType": "sum",
                        "fieldName": "traffic"
                    }
                ],
                "timeFrame": "last.P1D"
            },
            "assertions": [
                "appStatsTimeSeries"
            ]
        },
        "query.eventsTimeSeries": {
            "payload": {
                "buckets": 168,
                "eventsDimension": [
                    {
                        "fieldName": "rule_name"
                    }
                ],
                "eventsFilter": [
                    {
                        "fieldName": "event_sub_type",
                        "operator": "is",
                        "values": [
                            "Internet Firewall"
                        ]
                    }
                ],
                "eventsMeasure": [
                    {
                        "aggType": "sum",
                        "fieldName": "event_count"
                    }
                ],
                "perSecond": false,
                "timeFrame": "last.P1D"
            },
            "assertions": [
                "eventsTimeSeries"
            ]
        },
