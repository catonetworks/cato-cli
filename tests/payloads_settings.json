{
    "ignoreOperations": {
        // Skipping query operations covered in custom payloads used in MCP
        "query.appStats": {},
        "query.appStatsTimeSeries": {},
        "query.eventsFeed": {},
        "query.eventsTimeSeries": {},
        "query.socketPortMetricsTimeSeries": {},
        "query.socketPortMetrics": {},
        "query.xdr.stories": {},
        "query.xdr.story": {},
        // The following require additional configuration
        "query.site.secondaryAwsVSocket": {},
        "query.site.secondaryAzureVSocket": {},
        // No BGP configured on the CI account's sites (needs a BGP-enabled socket)
        "query.site.bgpPeer": {},
        "query.site.bgpPeerList": {},
        "query.site.siteBgpStatus": {},
        // No Cloud Interconnect site on the CI account (needs a provisioned interconnect)
        "query.site.cloudInterconnectConnectionConnectivity": {},
        "query.site.cloudInterconnectPhysicalConnection": {},
        "query.site.cloudInterconnectPhysicalConnectionId": {},
        // No Wi-Fi capable site / SSID configured on the CI account
        "query.site.wifiSsidList": {},
        "query.site.wifiSsid": {},
        "query.site.wifiRadioProfileList": {},
        "query.site.wifiRadioProfile": {},
        "query.site.wifiRadioProfileBySite": {},
        "query.site.validWifiRadioSettings": {},
        "query.site.validateWifiRadioProfile": {},
        // Needs a provisioned secondary GCP vSocket / SP+POP VLAN data not present on CI account
        "query.site.secondaryGcpVSocket": {},
        "query.site.retrieveUsedVlanIDs": {},
        // knownHostList returns internal server error (downstream) on the test environment
        "query.site.knownHostList": {},
        // // The following queries need investigation
        "query.devices": {},
        "query.groups.groupList": {}, // generated query selects illegal 'members' field in list context
        "query.policy.terminalServer.policy": {}, // Access denied: insufficient privileges for account
        "query.catalogs.catalogApplicationList": {}, // Server cannot retrieve applications data
        // Requires live ZTNA connector snapshot data (multiple required snapshot inputs)
        "query.connectivitySnapshots": {},
        // Server-side bugs on the test environment (schema/data defects, not input related)
        "query.notification": {}, // Unknown type 'CustomHeadersAuth'; ActorRef non-null wrongly returned null
        "query.externalAccess": {}, // incoming/partnerAccessRequestList: "Something went wrong! Please try again later"
        "query.popLocations": {}, // popLocations.bgpProfile: Server Error
        // Early-access APIs / insufficient API-key permissions on the CI account
        "query.aiSecurity": {}, // Internal server error + API key lacks sufficient permissions
        "query.businessPlatform": {}, // "We gradually rolling out this API..."
        "query.hardwareManagement": {}, // "We gradually rolling out this API..."
        "query.policy.socketBypass.policy": {} // Access denied: insufficient privileges for account
    },
    "defaultValues": {
        "timeFrame": "last.P1D",
        "adminID": "43696",
        "platforms": [
            "OSX"
        ]
    },
